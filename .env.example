# =============================================================
# KHMER AI CODING AGENT - Environment Variables Example
# Copy this file to .env and fill in real values
# NEVER commit .env to git
# =============================================================

# App
NODE_ENV=development
APP_VERSION=1.0.0

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_BYTE_HEX_STRING

# Encryption key for API keys stored in DB (32 bytes hex)
ENCRYPTION_KEY=CHANGE_THIS_TO_A_RANDOM_32_BYTE_HEX_STRING

# Database (SQLite path relative to userData)
DATABASE_URL=file:./khmer-ai.db

# Local API server port
API_SERVER_PORT=8787
