{
  "name": "khmer-ai-coding-agent",
  "version": "1.0.0",
  "description": "កម្មវិធី AI Coding Agent សម្រាប់អ្នកប្រើប្រាស់ខ្មែរ",
  "main": "dist/main/index.js",
  "homepage": "./",
  "author": {
    "name": "Khmer AI Team",
    "email": "support@khmerai.dev"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\" \"wait-on http://localhost:5173 && electron .\"",
    "package": "npm run build && electron-builder --win",
    "package:dir": "npm run build && electron-builder --win --dir",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "test": "jest --passWithNoTests",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "4.6.0",
    "@prisma/client": "5.7.1",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "axios": "1.6.5",
    "dayjs": "1.11.10",
    "electron-log": "5.1.1",
    "electron-store": "8.1.0",
    "electron-updater": "6.1.7",
    "monaco-editor": "0.45.0",
    "recharts": "2.10.3",
    "systeminformation": "5.21.25",
    "tree-kill": "1.2.2",
    "uuid": "9.0.1",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "@types/uuid": "9.0.7",
    "@typescript-eslint/eslint-plugin": "6.19.1",
    "@typescript-eslint/parser": "6.19.1",
    "@vitejs/plugin-react": "4.2.1",
    "autoprefixer": "10.4.17",
    "concurrently": "8.2.2",
    "electron": "28.1.3",
    "electron-builder": "24.9.1",
    "eslint": "8.56.0",
    "jest": "29.7.0",
    "postcss": "8.4.35",
    "prisma": "5.7.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "3.4.1",
    "ts-jest": "29.1.2",
    "typescript": "5.3.3",
    "vite": "5.0.12",
    "vite-plugin-monaco-editor": "1.1.0",
    "wait-on": "7.2.0"
  },
  "build": {
    "appId": "dev.khmerai.coding-agent",
    "productName": "Khmer AI Coding Agent",
    "copyright": "Copyright © 2024 Khmer AI Team",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "prisma/**/*",
      "resources/**/*",
      "node_modules/.prisma/**/*",
      "node_modules/@prisma/client/**/*"
    ],
    "extraResources": [
      {
        "from": "prisma",
        "to": "prisma"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Khmer AI Coding Agent"
    }
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
